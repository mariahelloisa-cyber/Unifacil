# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching

# Arquivos do build: o nome muda a cada deploy, então podem ficar em cache para sempre.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Imagens, frames da intro e vídeo: o nome não muda quando o arquivo é trocado,
# então o cache dura 1 dia (depois o navegador ainda usa a cópia por até 7 dias
# enquanto confere se há versão nova em segundo plano).
/images/*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800

/frames/*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
